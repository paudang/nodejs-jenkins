# Application
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=27017
DB_NAME=demo

# Communication
KAFKA_BROKER=localhost:9093
KAFKA_CLIENT_ID=zzzzzz
KAFKA_GROUP_ID=zzzzzz-group

# Caching
